<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<RootNamespace>CRM.WebBlazor</RootNamespace>
		<AssemblyName>CRM.WebBlazor</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.14" />
		<PackageReference Include="MudBlazor" Version="9.12.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CRM.Model\CRM.Model.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="LocalizationResource\Resource.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resource.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="LocalizationResource\Resource.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Resource.Designer.cs</LastGenOutput>
			<CustomToolNamespace>CRM.WebBlazor.LocalizationResource</CustomToolNamespace>
		</EmbeddedResource>
	</ItemGroup>

</Project>